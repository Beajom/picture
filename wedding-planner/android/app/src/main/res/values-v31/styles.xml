<resources>
  <style name="Theme.WeddingPlanner" parent="android:style/Theme.Material.Light.NoActionBar">
    <item name="android:statusBarColor">@color/wedding_cream</item>
    <item name="android:navigationBarColor">@color/wedding_cream</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:windowLightNavigationBar">true</item>
    <item name="android:windowBackground">@color/wedding_cream</item>
    <item name="android:colorAccent">@color/wedding_rose</item>
    <item name="android:windowSplashScreenBackground">@color/wedding_cream</item>
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    <item name="android:windowSplashScreenIconBackgroundColor">@color/wedding_rose</item>
    <item name="android:windowSplashScreenAnimationDuration">150</item>
  </style>
</resources>